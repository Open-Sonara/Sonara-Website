# Sonara website configuration. Copy to .env.local for development or .env for Docker Compose.
# Nothing here is required: the site builds and runs with no environment at all.

# Canonical origin used in metadata, the sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://opensonara.com

# Optional GitHub token (no scopes needed for public data). Raises the API rate limit
# for repository statistics. Read on the server only and never sent to the browser.
GITHUB_TOKEN=

# Host port for docker compose.
WEBSITE_PORT=3000

# Static export only: serve from a sub-path, e.g. /Sonara-Website on GitHub Pages.
# SONARA_BASE_PATH=
