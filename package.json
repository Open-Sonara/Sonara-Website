{
  "name": "sonara-website",
  "version": "0.1.0",
  "private": true,
  "description": "The official website for Sonara, the open-source, self-hosted music platform by Open Sonara.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Sonara/Sonara-Website.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:static": "cross-env SONARA_OUTPUT=export next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "github:snapshot": "node scripts/github-snapshot.mjs"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@next/swc-wasm-nodejs": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "geist": "^1.9.2",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.29.16": "7.29.13",
      "@babel/generator@7.29.16": "7.29.15",
      "@babel/helper-module-transforms@7.29.16": "7.29.14",
      "@babel/helpers@7.29.16": "7.29.15",
      "@babel/runtime@7.29.16": "7.29.15",
      "@babel/traverse@7.29.16": "7.29.15",
      "@eslint-community/regexpp@4.12.4": "4.12.3",
      "postcss@8.5.34": "8.5.33",
      "tldts@7.6.2": "7.6.1",
      "tldts-core@7.6.2": "7.6.1",
      "undici@8.14.0": "8.13.1"
    }
  }
}
